py/.venv-*/

# Re-downloadable MT snapshots (see ft/kb-v6/SOURCES.json; 1.5G, no commit-hash pin)
ft/kb-v6/mt-models/

# Raw downloads (re-fetch per SOURCES.json / build scripts; built outputs ARE committed)
ft/kb-v6/raw/
ft/base-v4/raw/
